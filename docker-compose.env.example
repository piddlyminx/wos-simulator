# Copy to `.env` (gitignored). `docker compose` loads it automatically.

# Local host port published by the optional Docker dev app.
APP_PORT=3000

# Turbopack file-watch polling interval in milliseconds for WSL2/SMB/NFS-backed
# bind mounts. Set to 0 to disable polling when native file notifications work.
NEXT_WATCH_POLL_INTERVAL_MS=1000

# Additional dev origins, comma-separated hostnames. Localhost is always allowed.
# Host Next reads dashboard/web/.env.local; Docker dev reads this root .env.
NEXT_ALLOWED_DEV_ORIGINS=

# Shared saved-run PostgreSQL connection. Set the complete URL privately.
# Docker production connects to service `postgres`; host/dev clients use a
# separately configured trusted endpoint or tunnel. No filesystem fallback.
# URL format: postgresql://<user>[:<password>]@<host>:<port>/<database>
DATABASE_URL=

# Production routing. Set the deployment hostname privately.
WOS_SIM_HOST=

# Select the production base plus an ignored private override for every command.
# Compose reads this from .env; exported values take precedence.
# COMPOSE_FILE=docker-compose.prod.yml:docker-compose.prod.override.yml
# The private override preserves existing published ports and, on established
# deployments, marks postgres_data external with its existing volume name.
# Do not use the production COMPOSE_FILE when starting the optional dev stack;
# select that stack explicitly with `docker compose -f docker-compose.yml`.

# Cleanup is an explicit maintenance command, never an HTTP side effect.
# Pass retention/size limits to `npm run runs:cleanup`; kept runs are exempt.
