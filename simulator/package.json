{
  "name": "wos-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:hero-manifest": "npx --yes tsx ../scripts/generate_hero_manifest.ts",
    "pretest": "npm run generate:hero-manifest",
    "pretypecheck": "npm run generate:hero-manifest",
    "test": "npx --yes tsx --test \"src/**/*.test.ts\"",
    "typecheck": "npx --yes --package typescript --package @types/node tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
